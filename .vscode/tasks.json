{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (uvicorn)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv-1/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Frontend (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start Backend + Frontend",
      "dependsOn": ["Backend (uvicorn)", "Frontend (npm run dev)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}