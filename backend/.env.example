# ToolSync Backend - Beispielkonfiguration
#
# Diese Datei ist versioniert und enthaelt KEINE echten Werte.
# Fuer die lokale Entwicklung kopieren:
#   Copy-Item backend\.env.example backend\.env
# und die Werte ausfuellen.

# Entwicklung: SQLite. Betrieb: PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/toolsync
DATABASE_URL=sqlite+aiosqlite:///./toolsync.db

# PFLICHT: langer Zufallswert. NIEMALS den Default aus config.py verwenden.
# Erzeugen mit:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

DEBUG=True