# Python / ToolSync
__pycache__/
*.py[cod]
.venv/
.venv-1/
*.log
backend/toolsync.db
backend/test.db

# Umgebungsvariablen mit Zugangsdaten (JWT-Secret, DB-URL, API-Keys).
# .env.example bleibt versioniert, .env selbst NICHT.
.env
.env.*
!.env.example

# Node / Frontend
node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

# Hochgeladene Dateien (Einrichteplaene, Datenblaetter, Bilder).
# Das sind Laufzeitdaten des Betriebs, kein Quelltext: sie gehoeren in die
# Ablage des Servers, nicht ins Repository. Der Ordner entsteht beim Anlegen
# selbst (`mkdir(parents=True, exist_ok=True)`).
backend/uploads/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Continue: MCP-Server-Konfigurationen enthalten Zugangsdaten.
# Die Regeln (.continue/rules/) und Prompts (.continue/prompts/) bleiben
# bewusst versioniert - das ist die Agenten-Steuerung des Projekts.
.continue/mcpServers/*
!.continue/mcpServers/README.md

# Lokale Sicherung der Null-Byte-Reparatur (nur zur Nachvollziehbarkeit)
.archive-nulbytes-backup/

# Playwright-MCP generiert bei jedem Lauf Snapshot-Dateien.
.playwright-mcp/

# Lokale Sicherung der alten Git-Historie vor dem Rewrite.
# Enthaelt die alte Historie inkl. kompromittiertem Key -> NICHT versionieren.
# Nach erfolgreicher Verifikation loeschbar.
.backup-history/

# Temporaere Screenshot-Pruefartefakte (nicht versionieren)
/aktion-panel-open.png
/stammdaten-*.png

# Pruefartefakte des UI-Audits: Skripte, Logs und Screenshots.
# Der Befundbericht selbst liegt versioniert in docs/19-frontend-ui-audit.md.
.audit/
# pytest legt bei abgebrochenen Laeufen Cache-Verzeichnisse im Projekt an.
pytest-cache-files-*
.pytest_cache/

